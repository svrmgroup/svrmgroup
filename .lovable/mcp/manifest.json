              "type": "string",
              "enum": [
                "clients",
                "contacts"
              ],
              "default": "clients"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "read_invoice",
        "title": "Read invoice data",
        "description": "Read stored invoice line items and amounts for a booking; excludes browser-only unsaved PDF edits and client portal tokens.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
