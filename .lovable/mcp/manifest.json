            "currency": {
              "type": "string",
              "enum": [
                "ZAR",
                "USD",
                "EUR",
                "GBP"
              ],
              "default": "ZAR"
            }
          },
          "required": [
            "start_date",
            "end_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
